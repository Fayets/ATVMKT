# --- Neon (recomendado): URL del dashboard → Connection string (pooler) ---
# Si DATABASE_URL está definida, se usa y se ignoran DB_HOST / DB_USER / etc.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# --- Alternativa: variables sueltas (mismo proyecto Neon) ---
DB_PROVIDER=postgres
DB_USER=
DB_PASS=
DB_HOST=
DB_NAME=
DB_PORT=5432
DB_SSLMODE=require

DISCORD_SETTER_WEBHOOK_URL=
DISCORD_CLOSER_VENTAS_WEBHOOK_URL=
# Análisis Fathom listos → canal marketing (antes: reporte marketing manual del closer)
DISCORD_CLOSER_MARKETING_WEBHOOK_URL=
# --- Secretos: obligatorios, sin valor por defecto. Generar con:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
# Firma los tokens de sesión del panel admin.
SECRET=
# Firma los JWT de login. Sin esto el backend no autentica a nadie (503).
# Al cambiarlo, todas las sesiones abiertas se caen y hay que volver a loguear.
JWT_SECRET=
# Alta de usuarios: POST /auth/register exige el header X-Register-Key con este valor.
# Vacío = nadie puede registrarse (503).
REGISTER_ADMIN_KEY=

# Panel admin (ruedita sidebar): corrección reportes closer por fecha
ADMIN_PANEL_PASSWORD=

# Agente externo (bot WhatsApp): GET /api/agent/* con header X-Agent-Key
ADMIN_API_KEY=
# user_id numérico (AuthUser) cuyos datos consulta el agente
AGENT_USER_ID=

# URL pública del frontend (sin barra final). En VPS: https://tu-dominio.com
PUBLIC_SITE_URL=http://localhost:3000

# Token secreto para webhooks ManyChat (python3 -c "import secrets; print(secrets.token_hex(24))")
MANYCHAT_WEBHOOK_TOKEN=

# Swagger en /docs y /openapi.json. Dejar en false en producción:
# el esquema de la API expone todos los endpoints a cualquiera.
ENABLE_DOCS=false
